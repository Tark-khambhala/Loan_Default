# Vite React Frontend Environment Variables
# =============================================
# VITE_ variables are PUBLIC — never put secrets here.
# =============================================

# Development (local FastAPI server)
# VITE_API_URL=http://127.0.0.1:8000

# Production (your actual Render backend URL — set this in Vercel dashboard)
# VITE_API_URL=https://<your-backend-name>.onrender.com

VITE_API_URL=http://127.0.0.1:8000
