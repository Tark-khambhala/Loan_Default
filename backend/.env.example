# FastAPI Backend Environment Variables
# =============================================
# Set these in your Render dashboard (NOT in .env committed to Git).
# =============================================

# Port (Render sets this automatically — do not override on Render)
PORT=8000

# CORS: The URL of your deployed Vercel frontend
# Development: http://localhost:5173
# Production:  https://<your-vercel-app>.vercel.app
FRONTEND_URL=http://localhost:5173
