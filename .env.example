# ==============================================================================
# ASTRO Loan Approval System — Environment Configuration Template
# DO NOT commit real values. Copy to .env and fill in your actual values.
# ==============================================================================

# --- Backend (Render) ---
# PORT is set automatically by Render — do not override on Render
PORT=8000
# Set to your actual Vercel frontend URL after deploying
FRONTEND_URL=https://<your-vercel-app>.vercel.app

# --- Frontend (Vercel) ---
# Set to your actual Render backend URL after deploying
# VITE_ vars are PUBLIC — never put secrets here
VITE_API_URL=https://<your-backend-name>.onrender.com
